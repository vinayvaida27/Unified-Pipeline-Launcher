{
  // v2 uses explicit source/display/runtime objects. Existing v1 apps.json files remain supported.
  "schema_version": 2,
  "policies": {
    "allow_external_paths": false,
    "allowed_roots": ["apps"],
    "require_loopback": true
  },
  "defaults": {
    "type": "streamlit",
    "source": {"entrypoint": "app.py", "requirements": null, "icon": null},
    "runtime": {"environment": "shared", "python_version": "3.11"},
    "launch": {
      "address": "127.0.0.1",
      "port": "dynamic",
      "headless": true,
      "file_watcher_type": "none",
      "gather_usage_stats": false,
      "startup_timeout_seconds": 60
    }
  },
  "applications": [
    {
      "id": "my-app",
      "source": {"folder": "my_app"},
      "display": {"name": "My App", "description": "Short description.", "category": "General", "order": 1, "enabled": true, "archived": false},
      "runtime": {"environment": "shared"}
    },
    {
      "id": "external-app",
      "source": {"entrypoint": "D:/approved/pipelines/my_app.py", "requirements": "D:/approved/pipelines/requirements.txt", "icon": null},
      "display": {"name": "External App", "description": "A direct Streamlit file.", "category": "External", "order": 2},
      "runtime": {"environment": "auto"}
    }
  ]
}
